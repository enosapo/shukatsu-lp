{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/saitan",
      "destination": "/saitan/",
      "permanent": true
    },
    {
      "source": "/standard-c",
      "destination": "/standard-c/",
      "permanent": true
    },
    {
      "source": "/lp/board",
      "destination": "/lp/board/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/saitan/nomuratakuya",
      "destination": "/saitan/"
    },
    {
      "source": "/saitan/nomuratakuya/",
      "destination": "/saitan/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/saitan/nomuratakuya(/?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/:lp/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
